# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/annseva

# JWT (required)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d

# Razorpay (required for online payments; COD works without it)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Cloudinary (optional - falls back to local /uploads/ if not configured)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (optional - falls back to console logging if not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Pricing (optional - GST rate applied to the items total, default 0.05 = 5%)
GST_RATE=0.05

# Frontend URL used for CORS and Socket.io
CLIENT_URL=http://localhost:3000
